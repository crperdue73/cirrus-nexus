# AEGIS FRR Base Image — DYNAMIC ROUTING variant (bgpd enabled)
#
# WHY THIS EXISTS (2026-09-23, Selina):
#   aegis/frr:latest deliberately asserts bgpd=no — it is the fundamentals base
#   ("not CCNP"). But lab-04-two-as-peering declares requires_daemons: [bgpd]
#   (six routers, one peering session, AS-path reasoning). The substrate guard
#   therefore refuses lab-04 with HTTP 409:
#     "requires daemons ['bgpd'], but aegis/frr:latest enables only
#      ['mgmtd','staticd','vtysh_enable','zebra']"
#   That is two contradictory intentions: a no-BGP base vs a BGP lab. Rather
#   than flip bgpd on in the fundamentals base (which the base's own assertions
#   are designed to prevent), this is a SEPARATE image for dynamic-routing labs.
#   Expected use: point lab-04 (and any future BGP/OSPF lab) at this image.
#
# SCOPE NOTE: building/publishing a new substrate image is a scoping decision
# (Dad's call). This file is a TESTED OPTION, not a unilateral change: the
# existing aegis/frr:latest is untouched.
FROM aegis/frr:latest

# Enable bgpd. Assert it, in the same spirit as the base image: a missing match
# must FAIL the build rather than ship a silently-wrong substrate.
RUN set -eu; \
    f=/etc/frr/daemons; \
    sed -i -E 's/^(ospfd|bgpd)=.*/\1=no/' "$f"; \
    sed -i -E 's/^bgpd=no$/bgpd=yes/' "$f"; \
    require() { \
        grep -qE "^$1=$2$" "$f" \
            || { echo "BUILD ASSERT FAILED: expected ^$1=$2$ in $f" >&2; \
                 grep -nE "^$1=" "$f" >&2 || true; exit 1; }; \
    }; \
    require bgpd yes; \
    require ospfd no; \
    echo 'FRR daemon state asserted: bgpd=yes ospfd=no'
